<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: glowing M3 pill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_glow" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/focus_stroke" />
        </shape>
    </item>
    <!-- Normal state: subtle card border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A2438" />
            <stroke android:width="1.5dp" android:color="#4D4460" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
