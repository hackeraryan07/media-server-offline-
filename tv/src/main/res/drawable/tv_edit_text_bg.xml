<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state on TV: bright border and luminous background -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A2438" />
            <stroke android:width="2.5dp" android:color="@color/focus_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B1724" />
            <stroke android:width="1dp" android:color="#363044" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
