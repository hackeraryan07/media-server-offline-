<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background">

    <!-- Connection / Discovery Layout -->
    <LinearLayout
        android:id="@+id/connection_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <!-- TV Card Container -->
        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/dialog_rounded_bg"
            android:padding="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV Stream Client"
                android:textColor="@color/text_bright"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <ProgressBar
                android:id="@+id/discovery_progress"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/accent_color"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/status_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/searching_servers"
                android:textColor="@color/text_muted"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:gravity="center" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#363044"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp" />

            <!-- Manual IP entry -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_ip"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center">

                <EditText
                    android:id="@+id/ip_input"
                    android:layout_width="220dp"
                    android:layout_height="48dp"
                    android:hint="192.168.1.50"
                    android:textColor="@color/text_bright"
                    android:textColorHint="@color/text_muted"
                    android:background="@drawable/tv_edit_text_bg"
                    android:lines="1"
                    android:textSize="16sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:imeOptions="actionDone"
                    android:textAlignment="center"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <Button
                    android:id="@+id/btn_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/connect_button"
                    android:background="@drawable/tv_btn_primary"
                    android:textColor="@color/tv_btn_text_color"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="140dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/retry_button"
                android:background="@drawable/tv_btn_primary"
                android:textColor="@color/tv_btn_text_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Leanback Fragment container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/browse_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
