<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fastlane_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:layout_marginBottom="24dp" />

        <Switch
            android:id="@+id/switch_prevent_screensaver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prevent Screen Saver while playing video"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="16dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default Video Player"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/radio_group_player_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_player_internal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Internal (LibVLC)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp"
                android:layout_marginEnd="16dp"
                android:buttonTint="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"/>

            <RadioButton
                android:id="@+id/radio_player_external"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="External Player"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp"
                android:layout_marginEnd="16dp"
                android:buttonTint="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"/>

            <RadioButton
                android:id="@+id/radio_player_ask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Always Ask"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp"
                android:buttonTint="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"/>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Internal Player Video Quality"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/radio_group_video_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_quality_peak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peak Quality (RV32 32-Bit / HW Direct)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp"
                android:layout_marginEnd="16dp"
                android:buttonTint="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"/>

            <RadioButton
                android:id="@+id/radio_quality_balanced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balanced Quality"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp"
                android:layout_marginEnd="16dp"
                android:buttonTint="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"/>

            <RadioButton
                android:id="@+id/radio_quality_powersave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compatibility Mode"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp"
                android:buttonTint="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"/>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default Auto-Resume Action (10s Timer)"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/radio_group_resume_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_start_over"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Over"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp"
                android:layout_marginEnd="16dp"
                android:buttonTint="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"/>

            <RadioButton
                android:id="@+id/radio_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp"
                android:buttonTint="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"/>
        </RadioGroup>
    </LinearLayout>
</ScrollView>
